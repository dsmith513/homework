# Read the data
cars <- read.csv("Cars.csv")
# Make sure driver and car are factors
cars$driver <- factor(cars$driver)
cars$car <- factor(cars$car)
# Fit the two-factor ANOVA model with interaction
model <- aov(mpg ~ driver * car, data = cars)
# ANOVA table
summary(model)

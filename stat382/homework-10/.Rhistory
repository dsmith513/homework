gapminder$year
# Number of ways to choose specific apples
numerator <- choose(700, 30) * choose(400, 20) * choose(600, 40) * choose(300, 10)
# Total number of ways to choose 100 apples from 2000
denominator <- choose(2000, 100)
# Probability
probability <- numerator / denominator
# Print the result
print(probability)
